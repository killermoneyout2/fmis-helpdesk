# Copy to .env and adjust for your machine. The app also runs on these
# defaults with no .env file if your MySQL matches them.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Passwords for the seeded demo accounts. Only read on the first boot, when the
# database is empty. Left unset, local runs use the defaults documented in the
# README; a production run generates random values and logs them instead.
COORDINATOR_PASSWORD=
STUDENT_PASSWORD=
STAFF_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fmis
DB_PASSWORD=fmis_pw
DB_NAME=fmis
